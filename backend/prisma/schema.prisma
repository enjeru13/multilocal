generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int              @id @default(autoincrement())
  email             String           @unique
  password          String
  name              String?
  role              Role             @default(EMPLOYEE)
  activo            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ordenesEntregadas Orden[]          @relation("DeliveredBy")
  cajaSesiones      CajaSesion[]
  cajaMovimientos   CajaMovimiento[]
}

model Cliente {
  id                  Int           @id @default(autoincrement())
  nombre              String
  apellido            String?
  tipo                TipoCliente?
  telefono            String?
  telefono_secundario String?
  direccion           String?
  identificacion      String?       @unique
  email               String?
  fechaRegistro       DateTime      @default(now())
  ordenes             Orden[]
  presupuestos        Presupuesto[]
}

model Categoria {
  id        String     @id @default(uuid())
  nombre    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  servicios Servicio[]
}

// "Servicio" es el catálogo genérico: puede ser un servicio puro (lavandería),
// un producto con stock (repuestos/minimarket), o ambos. Los campos de
// inventario quedan sin uso cuando controlaStock=false.
model Servicio {
  id               Int     @id @default(autoincrement())
  nombreServicio   String
  descripcion      String?
  precioBase       Float
  permiteDecimales Boolean @default(false)
  categoriaId      String

  tipo         ItemTipo @default(SERVICIO)
  unidadMedida String   @default("unidad")

  controlaStock Boolean @default(false)
  sku           String? @unique
  codigoBarras  String? @unique
  costoBase     Float?
  stockActual   Float   @default(0)
  stockMinimo   Float?

  // Productos sin IVA (p. ej. alimentos básicos) aunque el negocio cobre impuesto.
  exentoImpuesto Boolean @default(false)

  detalleOrdenes      DetalleOrden[]
  categoria           Categoria              @relation(fields: [categoriaId], references: [id])
  compraDetalles      CompraDetalle[]
  movimientos         InventarioMovimiento[]
  presupuestoDetalles PresupuestoDetalle[]
  conteoDetalles      ConteoDetalle[]

  @@index([categoriaId], map: "Servicio_categoriaId_fkey")
}

// "Orden" es el documento genérico: ticket de servicio (lavandería, con
// flujo de entrega) o venta instantánea (repuestos/minimarket, sin flujo
// de entrega). El campo tipo distingue el comportamiento esperado.
model Orden {
  id                  Int           @id @default(autoincrement())
  clienteId           Int?
  tipo                DocumentoTipo @default(ORDEN_LAVANDERIA)
  estado              EstadoOrden   @default(PENDIENTE)
  fechaIngreso        DateTime      @default(now())
  fechaEntrega        DateTime?
  observaciones       String?
  total               Float
  // Desglose del cobro. total = subtotal - descuento (+ impuesto si los
  // precios no lo incluían). Todo neto de devoluciones.
  subtotal            Float         @default(0)
  descuento           Float         @default(0)
  descuentoTipo       String?
  descuentoValor      Float?
  impuesto            Float         @default(0)
  impuestoTasa        Float?
  // Tasas del día de la venta (unidades por 1 USD), para el libro de ventas. Nulas en ventas anteriores a este registro.
  tasaVES             Float?
  tasaCOP             Float?
  devuelto            Float         @default(0)
  abonado             Float         @default(0)
  faltante            Float         @default(0)
  estadoPago          EstadoPago    @default(INCOMPLETO)
  deliveredByUserId   Int?
  deliveredByUserName String?
  cajaSesionId        Int?

  detalles     DetalleOrden[]
  cliente      Cliente?       @relation(fields: [clienteId], references: [id])
  deliveredBy  User?          @relation("DeliveredBy", fields: [deliveredByUserId], references: [id])
  cajaSesion   CajaSesion?    @relation(fields: [cajaSesionId], references: [id])
  pagos        Pago[]
  devoluciones Devolucion[]
  presupuesto  Presupuesto?

  @@index([clienteId])
  @@index([estado])
  @@index([deliveredByUserId])
  @@index([cajaSesionId])
}

model DetalleOrden {
  id                 Int                 @id @default(autoincrement())
  ordenId            Int
  servicioId         Int
  cantidad           Float
  precioUnit         Float
  costoUnit          Float?
  subtotal           Float
  // Reparto del descuento/impuesto en la línea; base = sin impuesto.
  descuento          Float               @default(0)
  impuesto           Float               @default(0)
  base               Float               @default(0)
  cantidadDevuelta   Float               @default(0)
  orden              Orden               @relation(fields: [ordenId], references: [id])
  servicio           Servicio            @relation(fields: [servicioId], references: [id])
  devolucionDetalles DevolucionDetalle[]

  @@index([ordenId], map: "DetalleOrden_ordenId_fkey")
  @@index([servicioId], map: "DetalleOrden_servicioId_fkey")
}

model Pago {
  id           Int               @id @default(autoincrement())
  ordenId      Int
  monto        Float
  moneda       Moneda
  metodoPago   MetodoPago
  tasa         Float             @default(0.00)
  nota         String?
  fechaPago    DateTime          @default(now())
  cajaSesionId Int?
  orden        Orden             @relation(fields: [ordenId], references: [id])
  cajaSesion   CajaSesion?       @relation(fields: [cajaSesionId], references: [id])
  vueltos      VueltoEntregado[]

  @@index([ordenId], map: "Pago_ordenId_fkey")
  @@index([cajaSesionId])
}

model VueltoEntregado {
  id     Int    @id @default(autoincrement())
  pagoId Int
  monto  Float
  moneda String
  pago   Pago   @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
}

// Antes "Configuracion": ahora además guarda el perfil de negocio (rubro,
// qué módulos están activos, terminología a mostrar en la UI).
model Configuracion {
  id                 Int     @id @default(1)
  nombreNegocio      String?
  monedaPrincipal    Moneda  @default(USD)
  // Monedas con las que trabaja el negocio (incluye la principal), separadas por coma.
  monedasActivas     String  @default("USD,VES,COP")
  tasaUSD            Float?
  tasaVES            Float?
  tasaCOP            Float?
  rif                String?
  direccion          String?
  telefonoPrincipal  String?
  telefonoSecundario String?
  mensajePieRecibo   String?

  rubro              Rubro            @default(GENERICO)
  moduloInventario   Boolean          @default(false)
  moduloProveedores  Boolean          @default(false)
  moduloCaja         Boolean          @default(false)
  moduloFechaEntrega Boolean          @default(true)
  moduloClienteTipo  Boolean          @default(true)
  clienteObligatorio Boolean          @default(true)
  deduccionStockEn   MomentoDeduccion @default(ENTREGA)
  terminologia       String?

  impuestoActivo          Boolean @default(false)
  impuestoNombre          String  @default("IVA")
  impuestoTasa            Float   @default(16)
  preciosIncluyenImpuesto Boolean @default(true)
  // Tope de descuento (%) para quien no es administrador.
  descuentoMaxPct         Float   @default(100)

  // Presupuestos (cotizaciones formales con número, validez y conversión a venta).
  moduloPresupuestos     Boolean @default(false)
  presupuestoValidezDias Int     @default(15)
  presupuestoCondiciones String?
}

model Proveedor {
  id             Int      @id @default(autoincrement())
  nombre         String
  identificacion String?  @unique
  telefono       String?
  direccion      String?
  email          String?
  createdAt      DateTime @default(now())
  compras        Compra[]
}

model Compra {
  id            Int             @id @default(autoincrement())
  proveedorId   Int
  proveedor     Proveedor       @relation(fields: [proveedorId], references: [id])
  fecha         DateTime        @default(now())
  estado        EstadoCompra    @default(PENDIENTE)
  total         Float           @default(0)
  observaciones String?
  detalles      CompraDetalle[]

  // Cuentas por pagar: lo abonado al proveedor y cuándo vence el saldo.
  montoPagado      Float        @default(0)
  fechaVencimiento DateTime?
  pagos            PagoCompra[]

  @@index([proveedorId])
}

model CompraDetalle {
  id         Int      @id @default(autoincrement())
  compraId   Int
  servicioId Int
  cantidad   Float
  costoUnit  Float
  subtotal   Float
  compra     Compra   @relation(fields: [compraId], references: [id])
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  @@index([compraId])
  @@index([servicioId])
}

model InventarioMovimiento {
  id              Int              @id @default(autoincrement())
  servicioId      Int
  servicio        Servicio         @relation(fields: [servicioId], references: [id])
  tipo            TipoMovimiento
  cantidad        Float
  motivo          MotivoMovimiento
  ordenId         Int?
  compraId        Int?
  stockResultante Float
  userId          Int?
  fecha           DateTime         @default(now())
  nota            String?

  @@index([servicioId])
  @@index([ordenId])
  @@index([compraId])
}

model CajaSesion {
  id                Int      @id @default(autoincrement())
  usuarioAperturaId Int
  usuarioApertura   User     @relation(fields: [usuarioAperturaId], references: [id])
  fechaApertura     DateTime @default(now())
  montoInicial      Float    @default(0)

  fechaCierre       DateTime?
  montoFinalContado Float?
  montoFinalSistema Float?
  diferencia        Float?

  estado            EstadoCaja @default(ABIERTA)
  observacionCierre String?
  // Arqueo por moneda al cerrar (JSON): esperado, contado y diferencia de cada una.
  detalleCierre     String?

  ordenes     Orden[]
  pagos       Pago[]
  movimientos CajaMovimiento[]

  @@index([estado])
}

model CajaMovimiento {
  id           Int                @id @default(autoincrement())
  cajaSesionId Int
  cajaSesion   CajaSesion         @relation(fields: [cajaSesionId], references: [id])
  tipo         TipoCajaMovimiento
  monto        Float
  moneda       Moneda             @default(USD)
  concepto     String
  userId       Int?
  usuario      User?              @relation(fields: [userId], references: [id])
  fecha        DateTime           @default(now())

  @@index([cajaSesionId])
}

enum TipoCliente {
  NATURAL
  EMPRESA
}

enum EstadoOrden {
  PENDIENTE
  LISTO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  PAGO_MOVIL
}

enum Moneda {
  USD
  VES
  COP
}

enum EstadoPago {
  COMPLETO
  INCOMPLETO
}

enum Role {
  ADMIN
  EMPLOYEE
  CAJERO
}

enum ItemTipo {
  PRODUCTO
  SERVICIO
  AMBOS
}

enum DocumentoTipo {
  ORDEN_LAVANDERIA
  VENTA
  TICKET_SERVICIO
}

enum Rubro {
  LAVANDERIA
  REPUESTOS
  MINIMARKET
  GENERICO
}

enum MomentoDeduccion {
  CREACION
  ENTREGA
}

enum EstadoCompra {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum MotivoMovimiento {
  COMPRA
  VENTA
  AJUSTE_MANUAL
  DEVOLUCION
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoCajaMovimiento {
  INGRESO
  EGRESO
}

// Devolución parcial: regresa unidades de una venta, devuelve stock y, si se
// pide, el dinero (como pago negativo). Deja historial de qué y cuánto.
model Devolucion {
  id        Int      @id @default(autoincrement())
  ordenId   Int
  fecha     DateTime @default(now())
  userId    Int?
  motivo    String?
  total     Float
  reembolso Float    @default(0)

  orden    Orden               @relation(fields: [ordenId], references: [id])
  detalles DevolucionDetalle[]

  @@index([ordenId])
}

model DevolucionDetalle {
  id             Int   @id @default(autoincrement())
  devolucionId   Int
  detalleOrdenId Int
  servicioId     Int
  cantidad       Float
  monto          Float

  devolucion   Devolucion   @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  detalleOrden DetalleOrden @relation(fields: [detalleOrdenId], references: [id])

  @@index([devolucionId])
  @@index([detalleOrdenId])
}

// Abono a una compra. monto va en moneda principal (es lo que baja el saldo);
// montoMoneda/moneda/tasa guardan cómo se pagó realmente.
model PagoCompra {
  id               Int        @id @default(autoincrement())
  compraId         Int
  fecha            DateTime   @default(now())
  monto            Float
  moneda           Moneda     @default(USD)
  montoMoneda      Float
  tasa             Float      @default(1)
  metodoPago       MetodoPago @default(EFECTIVO)
  nota             String?
  userId           Int?
  cajaMovimientoId Int?

  compra Compra @relation(fields: [compraId], references: [id])

  @@index([compraId])
}

// Gasto operativo (alquiler, servicios, sueldos...). Igual que los pagos a
// proveedores: monto en moneda principal + el detalle de cómo se pagó.
model Gasto {
  id               Int        @id @default(autoincrement())
  fecha            DateTime   @default(now())
  concepto         String
  categoria        String
  monto            Float
  moneda           Moneda     @default(USD)
  montoMoneda      Float
  tasa             Float      @default(1)
  metodoPago       MetodoPago @default(EFECTIVO)
  proveedorId      Int?
  nota             String?
  userId           Int?
  cajaMovimientoId Int?

  @@index([fecha])
  @@index([categoria])
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  CONVERTIDO
}

// Oferta al cliente antes de vender: no mueve stock ni caja. Al aceptarse se convierte
// en una Orden (ordenId). "Vencido" no se guarda: se deduce de validoHasta.
model Presupuesto {
  id               Int               @id @default(autoincrement())
  clienteId        Int?
  // Para quien todavía no es cliente registrado.
  contactoNombre   String?
  contactoTelefono String?
  fecha            DateTime          @default(now())
  validoHasta      DateTime
  estado           EstadoPresupuesto @default(BORRADOR)
  observaciones    String?
  condiciones      String?
  subtotal         Float             @default(0)
  descuento        Float             @default(0)
  descuentoTipo    String?
  descuentoValor   Float?
  impuesto         Float             @default(0)
  impuestoTasa     Float?
  total            Float             @default(0)
  ordenId          Int?              @unique
  userId           Int?
  userName         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  cliente  Cliente?             @relation(fields: [clienteId], references: [id])
  orden    Orden?               @relation(fields: [ordenId], references: [id])
  detalles PresupuestoDetalle[]

  @@index([clienteId])
  @@index([estado])
  @@index([fecha])
}

model PresupuestoDetalle {
  id            Int     @id @default(autoincrement())
  presupuestoId Int
  // Nulo en líneas libres (mano de obra, instalación, traslado…).
  servicioId    Int?
  descripcion   String
  cantidad      Float
  precioUnit    Float
  exento        Boolean @default(false)
  subtotal      Float
  descuento     Float   @default(0)
  impuesto      Float   @default(0)
  base          Float   @default(0)

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  servicio    Servicio?   @relation(fields: [servicioId], references: [id])

  @@index([presupuestoId])
  @@index([servicioId])
}

enum EstadoConteo {
  ABIERTO
  APLICADO
  CANCELADO
}

// Toma de inventario físico: se cuenta lo que hay en los estantes y al aplicar se ajustan las
// existencias del sistema a lo contado, dejando un movimiento por cada diferencia.
model ConteoInventario {
  id          Int          @id @default(autoincrement())
  nombre      String?
  // Si se indica, el conteo abarca solo esa categoría.
  categoriaId String?
  estado      EstadoConteo @default(ABIERTO)
  creadoEn    DateTime     @default(now())
  aplicadoEn  DateTime?
  userId      Int?
  userName    String?

  detalles ConteoDetalle[]

  @@index([estado])
}

model ConteoDetalle {
  id         Int    @id @default(autoincrement())
  conteoId   Int
  servicioId Int
  contado    Float
  // Se fijan al aplicar: lo que decía el sistema en ese momento y la diferencia resultante.
  esperado   Float?
  diferencia Float?
  costoUnit  Float?

  conteo   ConteoInventario @relation(fields: [conteoId], references: [id], onDelete: Cascade)
  servicio Servicio         @relation(fields: [servicioId], references: [id])

  @@unique([conteoId, servicioId])
  @@index([servicioId])
}
